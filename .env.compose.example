# Compose overrides for the local stack (copy to .env).
# Only these values are read by docker-compose.yml; backend behaviour is still
# configured through backend/.env (mounted into the container as env_file).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DB=sec_llm_db
APP_DB_USER=sec_llm
APP_DB_PASSWORD=change-me-app

# --- Browser-facing backend URL (baked into the frontend bundle) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- First-start admin (>=12 chars; change this) ---
INITIAL_ADMIN_PASSWORD=change-me-before-exposing

# --- LLM / tools ---
# On Docker Desktop the host Ollama is reachable at host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_SANDBOX_IMAGE=sec-llm-sandbox:latest
# Shared secret between API and sandbox-runner (change in production).
SANDBOX_RUNNER_TOKEN=dev-runner-token-change-me
SANDBOX_RUNNER_CONCURRENCY=4

# --- Shared state ---
# Cross-worker login throttling; empty falls back to in-process counters.
REDIS_URL=redis://redis:6379/0

# --- Sessions / quotas ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DAILY_AGENT_QUOTA=100
DAILY_CHAT_QUOTA=1000
DAILY_TOKEN_BUDGET=0
LLM_COST_PER_1K_PROMPT=0
LLM_COST_PER_1K_COMPLETION=0
